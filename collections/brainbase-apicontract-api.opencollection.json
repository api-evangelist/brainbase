            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user/contracts",
            "params": [
              {
                "name": "maxRows",
                "value": "",
                "type": "query",
                "description": "Max count of rows"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get all contracts associated with the user and perform filter and search via query parameter."
        }
      ]
    }
  ],
  "bundled": true
}